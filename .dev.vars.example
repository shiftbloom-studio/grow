# Copy to .dev.vars for local development (never commit .dev.vars).
# Both are optional. Without them, sign-in works with dashboard keys only.
# Create an app at https://dev.twitch.tv/console/apps with redirect URL
# http://localhost:8787/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Public origin used in overlay links. Defaults to the request origin.
# PUBLIC_URL=http://localhost:8787
